{
  "name": "molly",
  "version": "0.1.0",
  "description": "Rotate the API keys and secrets for all your projects with one command. Molly finds every key across your repos, rotates it through each platform’s API, and updates every .env file, GitHub secret and Vercel env var that uses it.",
  "keywords": [
    "secrets",
    "api-keys",
    "key-rotation",
    "rotate",
    "dotenv",
    "env",
    "github-actions",
    "vercel",
    "security",
    "cli",
    "tui",
    "devtools"
  ],
  "homepage": "https://github.com/lukechable/molly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukechable/molly.git"
  },
  "bugs": {
    "url": "https://github.com/lukechable/molly/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "molly": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0",
    "@napi-rs/keyring": "^2.1.2",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "libsodium-wrappers": "^0.8.4",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
