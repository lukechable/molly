    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "libsodium-wrappers": "^0.8.4",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
